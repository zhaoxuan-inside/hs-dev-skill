{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Payment Gateway Contract",
  "type": "object",
  "required": ["request", "response"],
  "properties": {
    "request": {
      "type": "object",
      "required": ["order_id", "amount"],
      "properties": {
        "order_id": { "type": "string" },
        "amount": { "type": "number" }
      }
    },
    "response": {
      "type": "object",
      "required": ["code", "msg"],
      "properties": {
        "code": { "type": "string" },
        "msg": { "type": "string" },
        "data": { "type": "object" }
      }
    }
  }
}
