{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "activity": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "current",
        "draft",
        "superseded"
      ]
    },
    "relations": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
