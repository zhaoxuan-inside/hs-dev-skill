{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "{contract_title}",
  "type": "object",
  "required": ["request", "response"],
  "properties": {
    "request": {
      "type": "object",
      "required": ["headers", "body"],
      "properties": {
        "headers": {
          "type": "object",
          "properties": {
            "X-Trace-Id": { "type": "string" },
            "X-Tenant-Id": { "type": "string" }
          },
          "required": ["X-Trace-Id", "X-Tenant-Id"]
        },
        "body": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "required": ["code", "msg"],
      "properties": {
        "code": { "type": "string" },
        "msg": { "type": "string" },
        "data": { "type": "object" }
      }
    }
  }
}
