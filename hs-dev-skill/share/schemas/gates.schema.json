{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gates.schema.json",
  "title": "Declared verification gates (hs_dev_docs/foundation/gates.json)",
  "description": "Once at least one entry is declared, verification accepts only gate:<id> selectors. Report paths must stay inside the runtime directory.",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "argv"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "title": { "type": "string" },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "report": {
            "type": "object",
            "required": ["format", "path"],
            "properties": {
              "format": { "const": "junit" },
              "path": { "type": "string", "pattern": "^hs-dev-skill/" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
