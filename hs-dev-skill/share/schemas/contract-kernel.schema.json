{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract-kernel.schema.json",
  "title": "Contract Kernel (:::contract block payload)",
  "description": "Machine authority embedded in Markdown. Links are resolved against blueprint/contract registries and index units; dangling links fail the consistency gate.",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(feature|behavior|interface|data|method):[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": { "type": "string" },
    "feature": { "type": ["string", "array"], "items": { "type": "string" } },
    "contract": { "type": ["string", "array"], "items": { "type": "string" } },
    "scenarios": { "type": "array", "items": { "type": "string" } },
    "covered_by": { "type": "array", "items": { "type": "string" } },
    "implemented_by": { "type": "array", "items": { "type": "string" } },
    "unimplemented_reason": { "type": "string" },
    "trigger": { "type": "string" },
    "precondition": { "type": "string" },
    "postcondition": { "type": "string" },
    "side_effects": { "type": "array", "items": { "type": "string" } },
    "output": { }
  },
  "additionalProperties": true
}
